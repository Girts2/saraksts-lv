# server/ = TĪRS KODA docroot. Šeit NEGLABĀJAM datus, kas lejupielādēti no data.gov.lv
# vai to apstrādes rezultātus — tos ģenerē būve (data_admin.php → "Palaist fonā" vai cron).
# Šis fails uzskaita datu artefaktus, lai tie nekad nenonāktu kodā.

# --- Izejdati un starprezultāti (ieteicams ĀRPUS docroot ar REG_DATA_DIR) ---
/csv/
/build_state/
ur_data.db
*.db

# --- Būves ģenerētie SQLite (rodas swap posmā, apkalpo lapas) ---
/registrs/assets/search/companies.sqlite
/registrs/assets/search/nace_stats.sqlite
/nozare/katalogs.sqlite
/pensionars/pensionari.sqlite

# --- Būves ģenerētā Struktūras lapa + treemap dati ---
/struktura.php
/struktura/data/

# --- VID ceturkšņu vēsture (uzkrāta; GLABĀT datu mapē, NE kodā) ---
vid_quarterly_history.sqlite

# --- Publiskā koda pakotne (ģenerē tools/build_download.php) ---
/lejupielade/saraksts-lv-kods.zip

# --- Noslēpumu saraksts ZIP būvēšanai (satur ĪSTĀS paroles/atslēgas — NEKAD necommitot!) ---
/tools/build_download.secrets.php

# --- Lejupielāžu skaitītāja DB (vairs netiek lietota; count.php noņemts 2026-07-26) ---
/lejupielade/downloads_stats.sqlite

# --- Darba/žurnāla faili ---
/registrs/ai_cache/*.json
/registrs/ai_cache/**/*.json
*.log
.DS_Store

# PIEZĪME: /lejupielade/*.zip un *.xlsm IR lejupielādes sadaļas saturs (jāaugšupielādē),
# nevis ģenerēti dati — tie NAV ignorēti.
